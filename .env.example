# ============================================================================
# B2B-Wholesale-Hub — local environment configuration
# Copy this file to `.env` (which is git-ignored) and adjust as needed:
#     cp .env.example .env
# Docker Compose reads `.env` automatically. All values below are LOCAL DEV
# defaults only — never commit real secrets (Req 19.4, 20.4).
# ============================================================================

# ---------------------------------------------------------------------------
# Service ports (host-exposed)
# ---------------------------------------------------------------------------
BFF_PORT=8080
AUTH_PORT=3001
INVENTORY_PORT=8081
SEARCH_PORT=8000
NOTIFICATION_PORT=3002
PAYMENT_PORT=3003

# ---------------------------------------------------------------------------
# PostgreSQL — one instance per service (schema/DB-per-service isolation)
# Host ports are distinct so all three can run simultaneously.
# ---------------------------------------------------------------------------
# Auth DB
POSTGRES_AUTH_DB=auth
POSTGRES_AUTH_USER=auth
POSTGRES_AUTH_PASSWORD=auth_local_pw
POSTGRES_AUTH_PORT=5432

# Inventory DB
POSTGRES_INVENTORY_DB=inventory
POSTGRES_INVENTORY_USER=inventory
POSTGRES_INVENTORY_PASSWORD=inventory_local_pw
POSTGRES_INVENTORY_PORT=5433

# Notifications DB
POSTGRES_NOTIF_DB=notifications
POSTGRES_NOTIF_USER=notifications
POSTGRES_NOTIF_PASSWORD=notif_local_pw
POSTGRES_NOTIF_PORT=5434

# Payment DB
POSTGRES_PAYMENT_DB=payment
POSTGRES_PAYMENT_USER=payment
POSTGRES_PAYMENT_PASSWORD=payment_local_pw
POSTGRES_PAYMENT_PORT=5435

# ---------------------------------------------------------------------------
# Redis (reservations + Redis Streams event bus)
# ---------------------------------------------------------------------------
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# ElasticSearch 8 (single-node, security disabled for LOCAL ONLY)
# ---------------------------------------------------------------------------
ELASTICSEARCH_PORT=9200

# ---------------------------------------------------------------------------
# Connection URLs consumed by the services (point at compose service names)
# ---------------------------------------------------------------------------
AUTH_DB_URL=postgres://auth:auth_local_pw@postgres-auth:5432/auth
INVENTORY_DB_URL=jdbc:postgresql://postgres-inventory:5432/inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory_local_pw
NOTIF_DB_URL=postgres://notifications:notif_local_pw@postgres-notif:5432/notifications
PAYMENT_DB_URL=postgres://payment:payment_local_pw@postgres-payment:5432/payment
REDIS_URL=redis://redis:6379
ELASTICSEARCH_URL=http://elasticsearch:9200

# Internal service URLs (used by the BFF to fan out)
AUTH_SERVICE_URL=http://auth:3001
INVENTORY_SERVICE_URL=http://inventory:8081
SEARCH_SERVICE_URL=http://search:8000
PAYMENT_SERVICE_URL=http://payment:3003

# ---------------------------------------------------------------------------
# Auth / JWT (RS256). For local dev, provide PEM key material or paths.
# In hosted environments these come from platform secret stores (Req 19.4).
# ---------------------------------------------------------------------------
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Payment provider secrets (local placeholders only)
# ---------------------------------------------------------------------------
BKASH_API_KEY=
BKASH_API_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_API_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ---------------------------------------------------------------------------
# Notification delivery (email/SMS) — disabled by default for local dev
# ---------------------------------------------------------------------------
EMAIL_ENABLED=false
SMS_ENABLED=false

# ---------------------------------------------------------------------------
# Cross-cutting
# ---------------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
