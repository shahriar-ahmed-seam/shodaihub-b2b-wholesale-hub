# ============================================================================
# Payment Gateway — local environment configuration (Req 19.4, 20.4).
# Provider credentials and API secrets MUST come from a secrets store / env,
# never from source (Req 19.4). All values below are LOCAL DEV placeholders.
# ============================================================================

NODE_ENV=development
PAYMENT_PORT=3003
LOG_LEVEL=info

# Postgres (payment schema). Self-migrates on boot in local/dev.
PAYMENT_DB_URL=postgres://payment:payment_local_pw@localhost:5432/payment

# Inventory Service base URL — used to fetch order totals and confirm orders.
INVENTORY_SERVICE_URL=http://localhost:8081

# Redis Streams event bus (payment + notification events).
REDIS_URL=redis://localhost:6379

# Payment timeout: if no authenticated success arrives within this many minutes,
# sub-orders stay PENDING and reservations expire naturally (Req 11.4).
PAYMENT_TIMEOUT_MINUTES=5

# ---------------------------------------------------------------------------
# Provider secrets (HMAC/callback verification + sandbox checkout). LOCAL only.
# ---------------------------------------------------------------------------
BKASH_API_KEY=
BKASH_API_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_API_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
