# Notification Service — local environment configuration (Req 20.4).
# These mirror the keys consumed by src/config.ts. In hosted environments they are supplied
# via the platform secret store (Req 19.4); never commit real secrets.

NODE_ENV=development
NOTIFICATION_PORT=3002
LOG_LEVEL=info

# Postgres connection (pg driver). Points at the compose `postgres-notifications` service by default.
NOTIFICATION_DB_URL=postgres://notifications:notifications_local_pw@localhost:5432/notifications

# Redis Streams (notification events). Consumer group reads the `notifications` stream.
REDIS_URL=redis://localhost:6379
NOTIFICATION_STREAM=notifications
NOTIFICATION_CONSUMER_GROUP=notification-service
NOTIFICATION_CONSUMER_NAME=notification-1

# Channel toggles (Req 14.1, 14.2). In-app is always on (persisted). Email/SMS use mock/console
# adapters here; real providers are wired via the secrets store in hosted environments.
EMAIL_ENABLED=false
SMS_ENABLED=false

# Delivery retry policy (Req 14.3): retry a failed delivery up to N times with exponentially
# increasing (non-decreasing) intervals before recording a failure / dead-lettering.
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_BACKOFF_BASE_MS=1000
NOTIFICATION_BACKOFF_FACTOR=2
NOTIFICATION_BACKOFF_MAX_MS=60000
