# Auth Service — local environment configuration (Req 20.4).
# These mirror the keys consumed by src/config.ts. In hosted environments they are supplied
# via the platform secret store (Req 19.4); never commit real secrets.

NODE_ENV=development
AUTH_PORT=3001
LOG_LEVEL=info

# Postgres connection (pg driver). Points at the compose `postgres-auth` service by default.
AUTH_DB_URL=postgres://auth:auth_local_pw@localhost:5432/auth

# RS256 JWT key material (PEM). Leave BOTH empty for local/test to auto-generate an ephemeral
# keypair at boot (tokens will not survive a restart — dev only).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Token lifetimes (design fixes access at 60 min, refresh at 7 days — Req 1.4).
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7

# Lockout policy (Req 1.7): lock for N minutes after THRESHOLD consecutive failures in the window.
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW_MINUTES=15
