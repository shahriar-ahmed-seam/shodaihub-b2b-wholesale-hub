# ============================================================================
# API Gateway / BFF — local environment configuration (Req 20.4).
# All values have local-dev defaults so the service runs without a populated
# .env. In hosted environments these are supplied via platform secret stores.
# ============================================================================

NODE_ENV=development
BFF_PORT=8080
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Upstream service base URLs the BFF fans out to (internal network only).
# ---------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:8081
SEARCH_SERVICE_URL=http://localhost:8000
PAYMENT_SERVICE_URL=http://localhost:3003

# ---------------------------------------------------------------------------
# JWT verification (RS256). The BFF only needs the PUBLIC key — it verifies
# tokens, it never signs them (the Auth Service signs with the private key).
# When absent, an ephemeral keypair is generated in-process for local/test
# use only (loudly logged; never rely on this in production) (Req 19.4).
# ---------------------------------------------------------------------------
JWT_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Request limits and rate limiting (Req 2.4, 19.3).
# ---------------------------------------------------------------------------
# Max request body size accepted at the edge.
BFF_BODY_LIMIT=256kb
# General per-IP rate limit: max requests per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Stricter limit for auth routes (login/register/refresh) to slow credential stuffing.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Upstream request timeout (ms) before returning 504.
UPSTREAM_TIMEOUT_MS=10000
