{
  "name": "@b2b/bff",
  "version": "0.1.0",
  "private": true,
  "description": "API Gateway / BFF (Node.js + TypeScript): verifies JWT once, propagates X-Correlation-Id, forwards identity headers, enforces a coarse role->route permission matrix + rate limiting, and proxies to Auth, Inventory, Search, and Payment.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@b2b/shared-node": "*",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.15",
    "fast-check": "^3.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
